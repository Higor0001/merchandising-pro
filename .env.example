# Banco de Dados MongoDB (Obrigatório)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=merchandising_pro

# Segurança & Autenticação (JWT_SECRET é OBRIGATÓRIA em produção / Vercel)
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# Lista separada por vírgulas de origens autorizadas no CORS (opcional)
CORS_ORIGINS=https://seu-app.vercel.app,http://localhost:5173
# Senha inicial usada apenas se o banco estiver vazio no primeiro seed (opcional)
SEED_DEFAULT_PASSWORD=

# Análise de Gôndola com IA Real (Gratuitas — configure uma ou ambas)
# 1) Groq Vision (grátis em https://console.groq.com)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# 2) Google AI Studio / Gemini Vision (grátis em https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Armazenamento de Imagens em CDN (Opcional — fallback automático para MongoDB GridFS)
CLOUDINARY_URL=
# ou configure separadamente:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Catálogo SI5 Global (Opcional)
SI5_API_TOKEN=

# Notificações no Telegram (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
